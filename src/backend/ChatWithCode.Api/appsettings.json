{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Metadata": "Host=localhost;Port=5432;Database=chatwithcode;Username=chatwithcode;Password=change-me;GSS Encryption Mode=Disable"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "AzureDevOps": {
    "Organization": "your-organization",
    "ExtensionSecret": null,
    "ServicePrincipal": {
      "TenantId": null,
      "ClientId": null,
      "ClientSecret": null
    }
  },
  "Indexing": {
    "MaxFileSizeKb": 500,
    "PollingEnabled": true,
    "PollIntervalMinutes": 0,
    "QueuePollSeconds": 3,
    "StaleJobMinutes": 60,
    "ExcludeGlobs": []
  },
  "Security": {
    "AllowedOrigins": [],
    "DataProtectionKeysPath": "/var/lib/chatwithcode/keys",
    "WebhookUsername": null,
    "WebhookPassword": null
  },
  "AzureOpenAI": {
    "Endpoint": null,
    "ApiKey": null,
    "UseManagedIdentity": false,
    "ChatDeployment": null,
    "EmbeddingDeployment": null,
    "EmbeddingDimensions": 1536
  },
  "VectorStore": {
    "Kind": "PgVector",
    "AzureSearchEndpoint": null,
    "AzureSearchIndexName": null,
    "AzureSearchApiKey": null
  },
  "Chat": {
    "RetentionDays": 30,
    "RequestsPerMinute": 20,
    "MaxSources": 12,
    "ContextTokens": 8000,
    "MaxAnswerTokens": 4000,
    "HistoryMessages": 6
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Metadata": "Host=localhost;Port=5432;Database=chatwithcode;Username=chatwithcode;Password=change-me;GSS Encryption Mode=Disable"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "AzureDevOps": {
    "Organization": "your-organization",
    "ExtensionSecret": null,
    "ServicePrincipal": {
      "TenantId": null,
      "ClientId": null,
      "ClientSecret": null
    },
    "PersonalAccessToken": null
  },
  "Indexing": {
    "MaxFileSizeKb": 500,
    "PollingEnabled": true,
    "PollIntervalMinutes": 5,
    "QueuePollSeconds": 3,
    "StaleJobMinutes": 60,
    "ExcludeGlobs": []
  },
  "Security": {
    "AllowedOrigins": [],
    "DataProtectionKeysPath": "/var/lib/chatwithcode/keys",
    "WebhookUsername": null,
    "WebhookPassword": null
  }
}

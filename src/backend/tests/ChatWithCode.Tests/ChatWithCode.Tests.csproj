<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Test naming and style rules that do not fit xUnit tests. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1062;CA2000;CA1001;CA1849;CA1861;CA1305;CA5350;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ChatWithCode.Core\ChatWithCode.Core.csproj" />
    <ProjectReference Include="..\..\ChatWithCode.Data\ChatWithCode.Data.csproj" />
    <ProjectReference Include="..\..\ChatWithCode.Api\ChatWithCode.Api.csproj" />
    <ProjectReference Include="..\..\ChatWithCode.Worker\ChatWithCode.Worker.csproj" />
    <ProjectReference Include="..\..\ChatWithCode.AzureDevOps\ChatWithCode.AzureDevOps.csproj" />
    <ProjectReference Include="..\..\ChatWithCode.AzureOpenAI\ChatWithCode.AzureOpenAI.csproj" />
    <ProjectReference Include="..\..\ChatWithCode.VectorStores.PgVector\ChatWithCode.VectorStores.PgVector.csproj" />
    <ProjectReference Include="..\..\ChatWithCode.VectorStores.AzureAISearch\ChatWithCode.VectorStores.AzureAISearch.csproj" />
  </ItemGroup>

</Project>
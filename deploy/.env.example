# Copy to .env and fill in. Never commit .env.

# Azure DevOps organization name: the part after https://dev.azure.com/
ADO_ORGANIZATION=your-organization

# Password for the bundled PostgreSQL database. Use a long random value.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Port the API listens on, on this machine.
API_PORT=8080

# --- Reading repositories ---
# A Microsoft Entra service principal (app registration) added to the Azure DevOps
# organization with Code (Read) access. See README.md, "Set up the service principal".
ADO_SP_TENANT_ID=
ADO_SP_CLIENT_ID=
ADO_SP_CLIENT_SECRET=

# --- Azure OpenAI (starting values for the organization defaults) ---
# Saved the first time the backend starts. After that, change them in the Azure DevOps
# settings page (from phase 4); editing them here has no effect once saved.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
# Use the backend's managed identity instead of an API key (when running in Azure).
AZURE_OPENAI_USE_MANAGED_IDENTITY=false
# Deployment names in your Azure OpenAI resource.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-6-luna

# --- Vector store (starting value, saved once like the Azure OpenAI values) ---
# PgVector keeps the index in the bundled PostgreSQL. AzureAISearch uses your Azure AI Search service.
VECTOR_STORE=PgVector
AZURE_SEARCH_ENDPOINT=
# Lowercase letters, digits and dashes. Created automatically on the first indexing run.
AZURE_SEARCH_INDEX=chat-with-code
# Admin key (or set AZURE_OPENAI_USE_MANAGED_IDENTITY=true to use managed identity for both services).
AZURE_SEARCH_API_KEY=

# --- Admins ---
# Sign-in emails of the people who may change Chat with code settings in Azure DevOps
# (models, keys, which repositories are indexed). Comma-separated. Everyone else sees them read-only.
CHAT_ADMINS=

# --- Chat ---
# Conversations with no new messages for this many days are deleted.
CHAT_RETENTION_DAYS=30
# Questions one user may ask per minute.
CHAT_REQUESTS_PER_MINUTE=20

# --- Indexing ---
# Files larger than this (KB) are skipped.
INDEX_MAX_FILE_KB=500
# Check for new commits on a timer (needed when Azure DevOps can't reach this backend).
INDEX_POLLING_ENABLED=true
INDEX_POLL_MINUTES=5

# --- Extension ---
# The extension's secret: Marketplace publisher portal > (your extension) > Certificate.
# Every chat request is checked against it. Changing the extension's scopes changes it.
ADO_EXTENSION_SECRET=

# --- Needed from later phases (leave empty for now) ---

# Browser origin of the installed extension, e.g. https://yourpublisher.gallerycdn.vsassets.io
EXTENSION_ORIGIN=

# Basic-auth credentials for Azure DevOps push notifications (service hooks).
WEBHOOK_USERNAME=
WEBHOOK_PASSWORD=

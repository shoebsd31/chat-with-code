# Copy to .env and fill in. Never commit .env.

# Azure DevOps organization name: the part after https://dev.azure.com/
ADO_ORGANIZATION=your-organization

# Password for the bundled PostgreSQL database. Use a long random value.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Port the API listens on, on this machine.
API_PORT=8080

# --- Needed from later phases (leave empty for now) ---

# Extension secret from the Marketplace publisher portal (validates calls from the extension).
ADO_EXTENSION_SECRET=

# How the backend reads repositories when indexing: an Entra service principal (recommended) ...
ADO_SP_TENANT_ID=
ADO_SP_CLIENT_ID=
ADO_SP_CLIENT_SECRET=
# ... or a personal access token with Code (Read) scope.
ADO_PAT=

# Browser origin of the installed extension, e.g. https://yourpublisher.gallerycdn.vsassets.io
EXTENSION_ORIGIN=

# Check for new commits on a timer (needed when Azure DevOps can't reach this backend).
INDEX_POLLING_ENABLED=true
INDEX_POLL_MINUTES=5

# Basic-auth credentials for Azure DevOps push notifications (service hooks).
WEBHOOK_USERNAME=
WEBHOOK_PASSWORD=
